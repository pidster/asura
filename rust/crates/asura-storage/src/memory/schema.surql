DEFINE TABLE graph_marker SCHEMAFULL;
DEFINE FIELD schema_version ON graph_marker TYPE int ASSERT $value = 1;
DEFINE FIELD installation_id ON graph_marker TYPE string;
DEFINE FIELD graph_id ON graph_marker TYPE string;
DEFINE FIELD init_operation_id ON graph_marker TYPE string;
DEFINE FIELD binding_generation ON graph_marker TYPE int ASSERT $value = 1;
DEFINE FIELD schema_digest ON graph_marker TYPE string;
DEFINE TABLE memory_note SCHEMAFULL;
DEFINE FIELD schema_version ON memory_note TYPE int ASSERT $value = 1;
DEFINE FIELD installation_id ON memory_note TYPE string;
DEFINE FIELD graph_id ON memory_note TYPE string;
DEFINE FIELD binding_generation ON memory_note TYPE int ASSERT $value = 1;
DEFINE FIELD context_id ON memory_note TYPE string;
DEFINE FIELD object_id ON memory_note TYPE string;
DEFINE FIELD operation_id ON memory_note TYPE string;
DEFINE FIELD body ON memory_note TYPE string;
DEFINE FIELD body_sha256 ON memory_note TYPE string;
DEFINE TABLE memory_link TYPE RELATION IN memory_note OUT memory_note SCHEMAFULL;
DEFINE FIELD schema_version ON memory_link TYPE int ASSERT $value = 1;
DEFINE FIELD installation_id ON memory_link TYPE string;
DEFINE FIELD context_id ON memory_link TYPE string;
DEFINE FIELD operation_id ON memory_link TYPE string;
DEFINE FIELD kind ON memory_link TYPE string ASSERT $value = 'derived_from';
DEFINE TABLE memory_receipt SCHEMAFULL;
DEFINE FIELD schema_version ON memory_receipt TYPE int ASSERT $value = 1;
DEFINE FIELD installation_id ON memory_receipt TYPE string;
DEFINE FIELD command_sha256 ON memory_receipt TYPE string;
DEFINE FIELD version_id ON memory_receipt TYPE string;
DEFINE FIELD edge_id ON memory_receipt TYPE option<string>;
