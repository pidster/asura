#!/bin/sh
# Build, sign and run the signed qualification of the team Keychain store
# (release signing design, packet SG3, SGQ6:
# docs/designs/release-signing.md#signed-qualification-run).
#
#   secret-store-qualification --ad-hoc --out DIR
#   secret-store-qualification --signed --out DIR
#        [--identity NAME] [--team-id ID] [--profile PATH]
#
# --signed reads missing inputs from ASURA_SIGN_IDENTITY, ASURA_TEAM_ID and
# ASURA_QUALIFICATION_PROFILE. The profile must be for the test App ID
# org.pidster.asura.test (development or Developer ID). The run writes items
# only in the access group <TeamID>.org.pidster.asura.test, purges that group
# first and last, and passes only when it ends empty (test-group-empty=yes).
#
# --ad-hoc signs ad hoc without restricted entitlements and expects the
# executable to refuse with no Keychain call. Both modes need ASURA_PROTOC
# for the Cargo build. Nothing here calls `security`, stores an input in a
# tracked file or has a time bound; the operator cancels with Ctrl-C.
set -eu
umask 022
PATH=/usr/bin:/bin:/usr/sbin:/sbin:$PATH
export PATH

step=arguments
fail() { printf 'secret-store-qualification: %s: %s\n' "$step" "$*" >&2; exit 1; }
note() { printf 'secret-store-qualification: %s\n' "$*"; }
trap 'printf "secret-store-qualification: %s: cancelled by the operator\n" "$step" >&2; exit 130' INT TERM

mode= out= arg_identity= arg_team= arg_profile= identity_args=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --ad-hoc|--signed)
            [ -z "$mode" ] || fail 'exactly one of --ad-hoc or --signed'
            mode=${1#--} ;;
        --out|--identity|--team-id|--profile)
            [ "$#" -ge 2 ] && [ -n "$2" ] || fail "$1 needs a value"
            case "$1" in
                --out) out=$2 ;;
                --identity) arg_identity=$2; identity_args=1 ;;
                --team-id) arg_team=$2; identity_args=1 ;;
                --profile) arg_profile=$2; identity_args=1 ;;
            esac
            shift ;;
        *) fail "unknown argument: $1" ;;
    esac
    shift
done
[ -n "$mode" ] || fail 'choose --ad-hoc or --signed'
[ -n "$out" ] || fail '--out DIR is required'

identity= team= profile=
if [ "$mode" = ad-hoc ]; then
    [ "$identity_args" -eq 0 ] || fail 'the ad hoc mode takes no identity, team or profile input'
else
    identity=${arg_identity:-${ASURA_SIGN_IDENTITY:-}}
    team=${arg_team:-${ASURA_TEAM_ID:-}}
    profile=${arg_profile:-${ASURA_QUALIFICATION_PROFILE:-}}
    [ -n "$identity" ] || fail 'signed needs the signing identity name (--identity or ASURA_SIGN_IDENTITY)'
    [ -n "$team" ] || fail 'signed needs the team ID (--team-id or ASURA_TEAM_ID)'
    [ -n "$profile" ] || fail 'signed needs the test App ID profile (--profile or ASURA_QUALIFICATION_PROFILE)'
    printf '%s\n' "$team" | grep -Eqx '[A-Z0-9]{10}' || fail 'the team ID must be ten upper-case letters or digits'
    case "$identity" in -) fail 'signed needs a named identity; use --ad-hoc for ad hoc signing' ;; esac
    [ -f "$profile" ] && [ ! -L "$profile" ] || fail 'the profile must be a regular file'
fi

# --- 1. Preflight -----------------------------------------------------------
step=preflight
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P) || fail 'cannot find the repository root'
[ "$(uname -s)" = Darwin ] || fail 'macOS is required'
[ "$(uname -m)" = arm64 ] || fail 'Apple silicon is required'
case "${ASURA_PROTOC:-}" in /*) ;; *) fail 'ASURA_PROTOC must be an absolute path to the verified protoc' ;; esac
[ -f "$ASURA_PROTOC" ] && [ -x "$ASURA_PROTOC" ] || fail 'ASURA_PROTOC must be an executable file'
case "$out" in /*) ;; *) out=$(pwd -P)/$out ;; esac
[ ! -e "$out" ] && [ ! -L "$out" ] || fail "the output directory must not exist: $out"
[ -d "$(dirname -- "$out")" ] || fail 'the parent of the output directory must exist'

pb() { /usr/libexec/PlistBuddy -c "Print :$1" "$2" 2>/dev/null; }
group=
if [ "$mode" = signed ]; then
    group=$team.org.pidster.asura.test
    # Decode the CMS envelope without a keychain; the signer is not trusted here.
    decoded=$(mktemp -d "${TMPDIR:-/tmp}/asura-qualification-profile.XXXXXXXX") || fail 'no temporary directory'
    trap 'rm -rf "$decoded"' EXIT
    openssl smime -verify -noverify -inform DER -in "$profile" -out "$decoded/profile.plist" 2>/dev/null ||
        fail 'cannot decode the provisioning profile'
    expires=$(plutil -extract ExpirationDate raw -o - "$decoded/profile.plist") || fail 'the profile has no expiry date'
    [ "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \< "$expires" ] || fail "the profile expired at $expires"
    plutil -extract TeamIdentifier json -o - "$decoded/profile.plist" | grep -Fq "\"$team\"" ||
        fail 'the profile is for another team'
    [ "$(pb Entitlements:com.apple.application-identifier "$decoded/profile.plist")" = "$group" ] ||
        fail "the profile application identifier is not $group (the test App ID)"
    pb Entitlements:keychain-access-groups "$decoded/profile.plist" |
        sed 's/^ *//' | grep -Fqx -e "$group" -e "$team.*" ||
        fail "the profile does not allow the keychain access group $group"
fi

mkdir -m 700 "$out" || fail "cannot create $out"
note "mode $mode, output $out"
[ "$mode" = ad-hoc ] || note "identity \"$identity\", team $team, group $group"

# --- 2. Build ---------------------------------------------------------------
step=build
target=$out/cargo-target
(cd "$root" && CARGO_TARGET_DIR=$target cargo build --release --locked -p asura-service \
    --features test-support --bin secret_store_qualification) || fail 'cargo build failed'
binary=$target/release/secret_store_qualification
[ -f "$binary" ] || fail 'the qualification binary is missing'

# --- 3. Assemble ------------------------------------------------------------
step=assemble
app=$out/AsuraKeychainQualification.app
mkdir -p "$app/Contents/MacOS"
ditto --norsrc --noextattr --noqtn "$binary" "$app/Contents/MacOS/secret_store_qualification"
cat > "$app/Contents/Info.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>secret_store_qualification</string>
	<key>CFBundleIdentifier</key>
	<string>org.pidster.asura.test</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AsuraKeychainQualification</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>27.0</string>
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
EOF
plutil -lint -s "$app/Contents/Info.plist" || fail 'invalid Info.plist'

# --- 4. Sign ----------------------------------------------------------------
step=sign
expected=$out/expected-entitlements.plist
if [ "$mode" = signed ]; then
    ditto --norsrc --noextattr --noqtn "$profile" "$app/Contents/embedded.provisionprofile"
    sed "s/@TEAM_ID@/$team/g" "$root/tools/release/entitlements/secret-store-qualification.plist" > "$expected"
    ! grep -q '@TEAM_ID@' "$expected" || fail 'an entitlement placeholder is left'
    plutil -lint -s "$expected" || fail 'invalid entitlements'
    codesign --force --sign "$identity" --timestamp=none --options runtime \
        --entitlements "$expected" "$app" || fail 'codesign failed'
else
    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' \
        '<plist version="1.0"><dict/></plist>' > "$expected"
    codesign --force --sign - --timestamp=none --options runtime "$app" || fail 'codesign failed'
fi
codesign --verify --strict "$app" || fail 'codesign --verify --strict failed'
codesign -d --entitlements - --xml "$app" > "$out/actual-entitlements.plist" 2>/dev/null || :
[ -s "$out/actual-entitlements.plist" ] ||
    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' \
        '<plist version="1.0"><dict/></plist>' > "$out/actual-entitlements.plist"
[ "$(plutil -p "$out/actual-entitlements.plist")" = "$(plutil -p "$expected")" ] ||
    fail 'the signed entitlements differ from the expected list'
details=$(codesign -d --verbose=2 "$app" 2>&1)
printf '%s\n' "$details" | grep -qx 'Identifier=org.pidster.asura.test' || fail 'the bundle identifier is not org.pidster.asura.test'
if [ "$mode" = signed ]; then
    printf '%s\n' "$details" | grep -qx "TeamIdentifier=$team" || fail "the bundle is not signed for team $team"
else
    printf '%s\n' "$details" | grep -qx 'Signature=adhoc' || fail 'the bundle is not ad hoc signed'
fi

# --- 5. Run -----------------------------------------------------------------
step=run
log=$out/qualification.log
set +e
"$app/Contents/MacOS/secret_store_qualification" > "$log" 2>&1
status=$?
set -e
cat "$log"
if [ "$mode" = ad-hoc ]; then
    [ "$status" -eq 3 ] && grep -q '^refused: ' "$log" ||
        fail "the ad hoc build did not refuse (exit $status)"
    ! grep -q '^PASS\|^FAIL\|^group ' "$log" || fail 'the ad hoc build ran a case'
    note 'ad hoc: refused with no Keychain call, as expected'
else
    [ "$status" -eq 0 ] || fail "the qualification failed (exit $status); see $log"
    grep -qx 'test-group-empty=yes' "$log" || fail 'the test group is not empty'
    grep -qx "group $group" "$log" || fail "the run did not use $group"
    note "signed: every case passed and $group is empty"
fi
