+[ x"$SOURCE_DATE_EPOCH" = x ] && die "SOURCE_DATE_EPOCH is not set"
+DATE="$(date -u -r "$SOURCE_DATE_EPOCH" 2>/dev/null|sed -e 's,  *, ,g')"
