#!/bin/sh
# Checks for the SG1 package script (release-signing.md#validation).
#
#   test-asura-bundle --static         SG-V1 and SG-V3 unit checks of the tracked
#                                      files; SG-V3 refusal checks of the script;
#                                      SG-V12 host-paths cases
#   test-asura-bundle --bundle APP     SG-V1, SG-V2 and SG-V12 checks of an
#                                      assembled ad hoc Asura.app (from
#                                      asura-bundle --ad-hoc), and the SG4 check
#                                      of its dry-run archive
#   test-asura-bundle --sandbox APP    SG-V5 checks of the helper App Sandbox with
#                                      an ad hoc Asura.app: a test-only signed
#                                      variant, the HS-P7 negative fixture and the
#                                      conversation_flow --bundle-sandbox journey
#
# --static needs ASURA_PROTOC and ASURA_PROTOC_GEN_SWIFT for the refusal cases
# that pass the generator preflight. --sandbox needs ASURA_PROTOC to build the
# journey; it runs MLX when ASURA_TEST_MLX_ASSET names a model directory and
# Ollama when a local Ollama already serves ASURA_TEST_OLLAMA_MODEL (default
# granite4.1:8b). No case signs with an identity, reads a keychain or builds
# the bundle; --sandbox signs ad hoc only, under probe identifiers.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin:$PATH
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
release=$root/tools/release
passed=0
failed=0
skipped=0
pass() { passed=$((passed + 1)); printf 'PASS %s\n' "$*"; }
bad() { failed=$((failed + 1)); printf 'FAIL %s\n' "$*"; }
skip() { skipped=$((skipped + 1)); printf 'SKIP %s\n' "$*"; }
check() { label=$1; shift; if "$@"; then pass "$label"; else bad "$label"; fi; }
sorted_keys() { plutil -convert json -o - "$1" | /usr/bin/python3 -I -c 'import json,sys; print(" ".join(sorted(json.load(sys.stdin))))'; }
value() { /usr/libexec/PlistBuddy -c "Print :$1" "$2" 2>/dev/null; }

static_checks() {
    # SG-V1 unit: every tracked property list parses and lists only allowed keys.
    for plist in "$release/Info.plist.in" "$release"/entitlements/*.plist; do
        check "parses: ${plist#"$root"/}" plutil -lint -s "$plist"
    done
    count=$(find "$release/entitlements" -type f | wc -l | tr -d ' ')
    check 'seven entitlement files' [ "$count" = 7 ]
    restricted='com.apple.application-identifier com.apple.developer.team-identifier keychain-access-groups'
    expect() { check "keys of $1: ${2:-none}" [ "$(sorted_keys "$release/entitlements/$1")" = "$2" ]; }
    expect asura.release.plist "$restricted"
    expect asura.development.plist "com.apple.application-identifier com.apple.developer.team-identifier com.apple.security.get-task-allow keychain-access-groups"
    expect asura.ad-hoc.plist ''
    sandbox='com.apple.security.app-sandbox com.apple.security.network.client com.apple.security.temporary-exception.files.home-relative-path.read-only'
    expect asura-model.release.plist "$sandbox"
    expect asura-model.ad-hoc.plist "$sandbox"
    expect asura-model.development.plist 'com.apple.security.app-sandbox com.apple.security.get-task-allow com.apple.security.network.client com.apple.security.temporary-exception.files.home-relative-path.read-only'
    # SG2 (SGQ7): every helper list claims the App Sandbox, the network client
    # and exactly the two read-only home-relative exceptions.
    for kind in release development ad-hoc; do
        file=$release/entitlements/asura-model.$kind.plist
        check "helper $kind app-sandbox is true" [ "$(value com.apple.security.app-sandbox "$file")" = true ]
        check "helper $kind network.client is true" [ "$(value com.apple.security.network.client "$file")" = true ]
        check "helper $kind read-only exceptions are the models and run directories" \
            [ "$(value com.apple.security.temporary-exception.files.home-relative-path.read-only "$file" | sed 's/^ *//' | tr '\n' ' ')" = 'Array { /.asura/data/models/ /.asura/run/ } ' ]
    done
    check 'no tracked list carries an absolute-path exception or a writable exception' sh -c \
        '! grep -lE "absolute-path|read-write" "$1"/entitlements/*.plist' sh "$release"
    check 'no list claims app-sandbox inheritance' sh -c '! grep -l "com.apple.security.inherit" "$1"/entitlements/*.plist' sh "$release"
    check 'asura lists do not claim the App Sandbox (D-S1)' sh -c '! grep -l "app-sandbox" "$1"/entitlements/asura.*.plist' sh "$release"
    for kind in release development; do
        file=$release/entitlements/asura.$kind.plist
        check "$kind application identifier" [ "$(value com.apple.application-identifier "$file")" = '@TEAM_ID@.org.pidster.asura' ]
        check "$kind team identifier" [ "$(value com.apple.developer.team-identifier "$file")" = '@TEAM_ID@' ]
        check "$kind access group is the only group" [ "$(value keychain-access-groups "$file" | sed 's/^ *//' | tr '\n' ' ')" = 'Array { @TEAM_ID@.org.pidster.asura } ' ]
    done
    # SG3: the qualification list names only the test App ID and group, so
    # the qualification bundle can never reach the production group.
    expect secret-store-qualification.plist "$restricted"
    file=$release/entitlements/secret-store-qualification.plist
    check 'qualification application identifier is the test App ID' [ "$(value com.apple.application-identifier "$file")" = '@TEAM_ID@.org.pidster.asura.test' ]
    check 'qualification team identifier' [ "$(value com.apple.developer.team-identifier "$file")" = '@TEAM_ID@' ]
    check 'qualification access group is the test group only' [ "$(value keychain-access-groups "$file" | sed 's/^ *//' | tr '\n' ' ')" = 'Array { @TEAM_ID@.org.pidster.asura.test } ' ]
    for file in asura.development.plist asura-model.development.plist; do
        check "$file get-task-allow is true" [ "$(value com.apple.security.get-task-allow "$release/entitlements/$file")" = true ]
    done
    # RS2: no false Boolean and no exception entitlement in any file.
    check 'no false Boolean entitlement' sh -c '! grep -l "<false/>" "$1"/entitlements/*.plist' sh "$release"
    check 'no Hardened Runtime exception entitlement' sh -c '! grep -l "com.apple.security.cs\." "$1"/entitlements/*.plist' sh "$release"
    info=$release/Info.plist.in
    check 'Info.plist keys' [ "$(sorted_keys "$info")" = 'CFBundleDevelopmentRegion CFBundleExecutable CFBundleIdentifier CFBundleInfoDictionaryVersion CFBundleName CFBundlePackageType CFBundleShortVersionString CFBundleVersion LSMinimumSystemVersion LSUIElement' ]
    check 'Info.plist bundle identifier' [ "$(value CFBundleIdentifier "$info")" = org.pidster.asura ]
    check 'Info.plist executable' [ "$(value CFBundleExecutable "$info")" = asura ]
    check 'Info.plist LSUIElement' [ "$(value LSUIElement "$info")" = true ]
    check 'Info.plist minimum system' [ "$(value LSMinimumSystemVersion "$info")" = 27.0 ]
    check 'Info.plist version placeholder' [ "$(value CFBundleVersion "$info")" = '@VERSION@' ]

    # SG-V3 unit: no signing material is tracked.
    check 'no tracked key, certificate bundle or profile file' sh -c \
        '[ -z "$(git -C "$1" ls-files -- "*.p12" "*.p8" "*.provisionprofile" "*.mobileprovision")" ]' sh "$root"
    check 'no tracked PEM private key' sh -c \
        '! git -C "$1" grep -lE -e "-----BEGIN [A-Z ]*PRIVATE KEY-----" -- .' sh "$root"
    check 'no tracked file names a team ID in place of the placeholder' sh -c \
        '! git -C "$1" grep -lE "[A-Z0-9]{10}\.org\.pidster\.asura" -- tools' sh "$root"

    # SG-V3 integration: the script refuses before building or signing.
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/asura-bundle-test.XXXXXXXX")
    script=$release/asura-bundle
    refuses() {
        label=$1 expected=$2; shift 2
        rm -rf "$scratch/out"
        set +e
        message=$(unset ASURA_SIGN_IDENTITY ASURA_TEAM_ID ASURA_PROFILE ASURA_NOTARY_PROFILE; "$@" 2>&1 >/dev/null)
        status=$?
        set -e
        if [ "$status" -eq 1 ] && printf '%s' "$message" | grep -Fq -- "$expected" && [ ! -e "$scratch/out" ]; then
            pass "refuses: $label"
        else
            bad "refuses: $label (status $status: $message)"
        fi
    }
    out=$scratch/out
    : > "$scratch/profile"
    refuses 'no mode' 'choose --ad-hoc' "$script" --out "$out"
    refuses 'two modes' 'exactly one' "$script" --ad-hoc --release --out "$out"
    refuses 'no output directory' '--out DIR is required' "$script" --ad-hoc
    for input in --identity --team-id --profile --notary-profile; do
        refuses "ad hoc with $input" 'takes no identity' "$script" --ad-hoc --out "$out" "$input" x
    done
    refuses 'release without identity' 'signing identity name' \
        "$script" --release --out "$out" --team-id ABCDE12345 --profile "$scratch/profile" --notary-profile n
    refuses 'release without team ID' 'team ID' \
        "$script" --release --out "$out" --identity 'Developer ID Application: T' --profile "$scratch/profile" --notary-profile n
    refuses 'release without profile' 'provisioning profile path' \
        "$script" --release --out "$out" --identity 'Developer ID Application: T' --team-id ABCDE12345 --notary-profile n
    refuses 'release without notary profile' 'notarytool keychain profile name' \
        "$script" --release --out "$out" --identity 'Developer ID Application: T' --team-id ABCDE12345 --profile "$scratch/profile"
    refuses 'development without identity' 'signing identity name' \
        "$script" --development --out "$out" --team-id ABCDE12345 --profile "$scratch/profile"
    refuses 'development with a notary profile' 'only --release notarises' \
        "$script" --development --out "$out" --identity 'Apple Development: T' --team-id ABCDE12345 --profile "$scratch/profile" --notary-profile n
    refuses 'malformed team ID' 'ten upper-case' \
        "$script" --development --out "$out" --identity 'Apple Development: T' --team-id abc --profile "$scratch/profile"
    refuses 'ad hoc identity name in a signed mode' 'needs a named identity' \
        "$script" --development --out "$out" --identity - --team-id ABCDE12345 --profile "$scratch/profile"
    refuses 'missing profile file' 'regular file' \
        "$script" --development --out "$out" --identity 'Apple Development: T' --team-id ABCDE12345 --profile "$scratch/none"
    refuses 'relative generator' 'absolute path' \
        env ASURA_PROTOC=protoc ASURA_PROTOC_GEN_SWIFT=/x "$script" --ad-hoc --out "$out"
    mkdir "$out.exists"
    if [ -n "${ASURA_PROTOC:-}" ] && [ -n "${ASURA_PROTOC_GEN_SWIFT:-}" ]; then
        refuses 'existing output directory' 'must not exist' "$script" --ad-hoc --out "$out.exists"
        refuses 'wrong generator version' 'is not protoc-gen-swift' \
            env ASURA_PROTOC_GEN_SWIFT="$ASURA_PROTOC" "$script" --ad-hoc --out "$out"
        # Profile checks run against a scratch copy of the script tree, whose
        # missing sources stop it at the generate step if the profile passes.
        tree=$scratch/tree
        mkdir -p "$tree/tools/release" "$tree/tools/protobuf" "$tree/rust/crates/asura-cli"
        cp -R "$release/." "$tree/tools/release/"
        cp "$root/tools/protobuf/lock.json" "$tree/tools/protobuf/"
        cp "$root/rust/crates/asura-cli/Cargo.toml" "$tree/rust/crates/asura-cli/"
        git -C "$tree" init -q
        git -C "$tree" add -A
        git -C "$tree" -c user.name=t -c user.email=t@example.invalid commit -qm tree
        openssl req -x509 -newkey rsa:2048 -nodes -keyout "$scratch/key.pem" -out "$scratch/cert.pem" \
            -days 1 -subj /CN=asura-bundle-test >/dev/null 2>&1
        profile_for() { # team application-group expiry get-task-allow -> CMS profile path
            cat > "$scratch/p.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>ExpirationDate</key><date>$3</date>
<key>TeamIdentifier</key><array><string>$1</string></array>
<key>Entitlements</key><dict>
<key>com.apple.application-identifier</key><string>$1.org.pidster.asura</string>
<key>keychain-access-groups</key><array><string>$2</string></array>
<key>com.apple.security.get-task-allow</key><$4/>
</dict></dict></plist>
EOF
            openssl smime -sign -in "$scratch/p.plist" -signer "$scratch/cert.pem" -inkey "$scratch/key.pem" \
                -outform DER -nodetach -binary -out "$scratch/$5.provisionprofile"
            printf '%s' "$scratch/$5.provisionprofile"
        }
        dev() { "$tree/tools/release/asura-bundle" --development --out "$out" \
            --identity 'Apple Development: T' --team-id ABCDE12345 --profile "$1"; }
        refuses 'expired profile' 'profile expired' dev "$(profile_for ABCDE12345 "ABCDE12345".org.pidster.asura 2020-01-01T00:00:00Z true expired)"
        refuses 'profile for another team' 'another team' dev "$(profile_for ZZZZZ12345 "ZZZZZ12345".org.pidster.asura 2099-01-01T00:00:00Z true team)"
        refuses 'profile without the access group' 'keychain access group' dev "$(profile_for ABCDE12345 ABCDE12345.com.other 2099-01-01T00:00:00Z true group)"
        refuses 'unsigned file as profile' 'cannot decode' dev "$scratch/profile"
        good=$(profile_for ABCDE12345 'ABCDE12345.*' 2099-01-01T00:00:00Z true good)
        rm -rf "$out"
        set +e
        message=$(unset ASURA_SIGN_IDENTITY; dev "$good" 2>&1 >/dev/null)
        set -e
        check 'a valid profile passes preflight (stops at generate in the scratch tree)' \
            sh -c 'printf "%s" "$1" | grep -Fq "asura-bundle: generate:"' sh "$message"
        rm -rf "$out"
        # SG4: macOS development profiles carry no get-task-allow; the
        # development lists still claim it, so the profile key is not read.
        set +e
        message=$(dev "$(profile_for ABCDE12345 'ABCDE12345.*' 2099-01-01T00:00:00Z false gta)" 2>&1 >/dev/null)
        set -e
        check 'a development profile without get-task-allow passes preflight (SG4)' \
            sh -c 'printf "%s" "$1" | grep -Fq "asura-bundle: generate:"' sh "$message"
        rm -rf "$out"
        rel() { "$tree/tools/release/asura-bundle" --release --out "$out" \
            --identity 'Developer ID Application: T' --team-id ABCDE12345 --profile "$1" --notary-profile n; }
        refuses 'Developer ID profile that grants get-task-allow' 'must not allow get-task-allow' \
            rel "$(profile_for ABCDE12345 'ABCDE12345.*' 2099-01-01T00:00:00Z true relgta)"
        set +e
        message=$(rel "$(profile_for ABCDE12345 'ABCDE12345.*' 2099-01-01T00:00:00Z false relgood)" 2>&1 >/dev/null)
        set -e
        check 'a Developer ID profile without get-task-allow passes preflight' \
            sh -c 'printf "%s" "$1" | grep -Fq "asura-bundle: generate:"' sh "$message"
        rm -rf "$out"
        : > "$tree/untracked"
        refuses 'release from an unclean tree' 'clean working tree' "$tree/tools/release/asura-bundle" --release --out "$out" \
            --identity 'Developer ID Application: T' --team-id ABCDE12345 --profile "$good" --notary-profile n
    else
        bad 'generator refusal and profile cases need ASURA_PROTOC and ASURA_PROTOC_GEN_SWIFT'
    fi
    # SG3: the qualification script refuses before building or signing.
    qualification=$release/secret-store-qualification
    rm -rf "$out"
    refuses 'qualification without a mode' 'choose --ad-hoc or --signed' "$qualification" --out "$out"
    refuses 'qualification with two modes' 'exactly one' "$qualification" --ad-hoc --signed --out "$out"
    refuses 'qualification ad hoc with an identity' 'takes no identity' "$qualification" --ad-hoc --out "$out" --identity x
    refuses 'qualification signed without a profile' 'test App ID profile' \
        "$qualification" --signed --out "$out" --identity 'Apple Development: T' --team-id ABCDE12345
    refuses 'qualification signed with a malformed team ID' 'ten upper-case' \
        "$qualification" --signed --out "$out" --identity 'Apple Development: T' --team-id abc --profile "$scratch/profile"
    refuses 'qualification signed ad hoc' 'named identity' \
        "$qualification" --signed --out "$out" --identity - --team-id ABCDE12345 --profile "$scratch/profile"
    sg4_static_checks
    host_paths_static_checks
    rm -rf "$scratch"
}

# SG4-O1 (release-signing.md#build-host-paths-sg4-o1): the scanner's needles,
# near misses and refusals, and its use by asura-release check. Uses $scratch
# from static_checks.
host_paths_static_checks() {
    scan() { /usr/bin/python3 -I "$release/host-paths" "$@"; }
    user=$(id -un)
    h=$scratch/host-paths
    mkdir -p "$h/clean" "$h/hits"
    # Near misses: another account's home, a longer user name, a reverse-DNS
    # name, the user name inside a word or alone, a remapped location, and a
    # longer name beside the (stand-in) repository /opt/asura-repo.
    printf 'org.%s.asura\0/Users/%s2/x\0/opt/%sx/y\0%s\0/cargo/registry/src/a.rs\0/opt/asura-repo-other/z\0' \
        "$user" "$user" "$user" "$user" > "$h/clean/near-misses.bin"
    # Hits: the home inside a longer string, the home alone, the repository,
    # the user name as a component under another prefix, and a link target.
    printf 'panic at %s/.cargo/registry/src/a.rs:1:2\0' "$HOME" > "$h/hits/home.bin"
    printf '\0%s\0' "$HOME" > "$h/hits/home-alone.bin"
    printf '/opt/asura-repo/target/release/build/x/out/a.rs\0/opt/asura-repo\0' > "$h/hits/repository.bin"
    printf 'x/opt/%s/src\0/var/%s\0' "$user" "$user" > "$h/hits/user.bin"
    ln -s "$HOME/elsewhere" "$h/hits/link"
    set +e
    out=$(scan --repository /opt/asura-repo "$h/clean" 2>&1); status=$?
    set -e
    check 'host-paths: near misses are not build-host paths (exit 0, no report)' sh -c '[ "$1" -eq 0 ] && [ -z "$2" ]' sh "$status" "$out"
    set +e
    out=$(scan --repository /opt/asura-repo "$h/hits" "$h/clean" 2>&1); status=$?
    set -e
    expect_line() { check "host-paths reports $1" sh -c 'printf "%s\n" "$1" | grep -Fqx -- "$2"' sh "$out" "$2"; }
    check 'host-paths: hits exit 1' [ "$status" -eq 1 ]
    expect_line 'the home in a longer string' 'hits/home.bin: home 1, repository 0, user 1'
    expect_line 'the home alone' 'hits/home-alone.bin: home 1, repository 0, user 1'
    expect_line 'the repository path' 'hits/repository.bin: home 0, repository 2, user 0'
    expect_line 'the user name as a path component' 'hits/user.bin: home 0, repository 0, user 2'
    expect_line 'a link target' 'hits/link: home 1, repository 0, user 1'
    check 'host-paths reports only the planted files' [ "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" = 5 ]
    check 'host-paths prints counts, never the matching text' sh -c '! printf "%s\n" "$1" | grep -Fq -e registry -e /opt/' sh "$out"
    printf '%s/x.rs\0' "$root" > "$h/real-repository.bin"
    set +e
    out=$(scan --repository "$root" "$h/real-repository.bin" 2>&1); status=$?
    set -e
    check 'host-paths reports this repository path' sh -c '[ "$1" -eq 1 ] && printf "%s\n" "$2" | grep -Fq ", repository 1,"' sh "$status" "$out"
    refuses_scan() { # LABEL ARGS... -> exit 2 before reading any file
        label=$1; shift
        set +e
        message=$("$@" 2>&1); status=$?
        set -e
        check "host-paths refuses: $label" sh -c '[ "$1" -eq 2 ] && printf "%s" "$2" | grep -q "^host-paths: "' sh "$status" "$message"
    }
    refuses_scan 'HOME set to /' env HOME=/ /usr/bin/python3 -I "$release/host-paths" --repository "$root" "$h/hits"
    refuses_scan 'HOME empty' env HOME= /usr/bin/python3 -I "$release/host-paths" --repository "$root" "$h/hits"
    refuses_scan 'a relative repository' scan --repository asura "$h/hits"
    refuses_scan 'a missing path' scan --repository "$root" "$h/none"
    refuses_scan 'no path' scan --repository "$root"
    # asura-release check runs the scanner over the extracted archive: a
    # planted LICENSE fails it; a clean one passes it.
    for kind in planted clean; do
        a=$h/$kind/asura-9.9.9-macos-arm64-adhoc-unstapled.tar.gz
        mkdir -p "$h/$kind/tree/Asura.app/Contents"
        printf 'x\n' > "$h/$kind/tree/Asura.app/Contents/Info.plist"
        if [ "$kind" = planted ]; then printf 'built in %s/src\n' "$HOME" > "$h/$kind/tree/LICENSE"; else printf 'MIT\n' > "$h/$kind/tree/LICENSE"; fi
        tar -czf "$a" -C "$h/$kind/tree" Asura.app LICENSE
        (cd "$h/$kind" && shasum -a 256 "$(basename "$a")" > "$(basename "$a").sha256")
        "$release/asura-release" check --ad-hoc --version 9.9.9 --archive "$a" > "$h/$kind/check.txt" 2>&1 || :
    done
    rule='no file holds the account home, the repository path or the user name (SG4-O1)'
    check 'check FAILs an archive whose LICENSE holds the home' grep -Fqx "FAIL $rule" "$h/planted/check.txt"
    check 'check names the planted file and its counts' grep -Fqx '  LICENSE: home 1, repository 0, user 1' "$h/planted/check.txt"
    check 'check PASSes the path rule on a clean archive' grep -Fqx "PASS $rule" "$h/clean/check.txt"
    check 'check prints no build-host NOTE any more' sh -c '! grep -q "^NOTE .*SG4-O1" "$1" "$2"' sh "$h/planted/check.txt" "$h/clean/check.txt"
}

# SG4 (release-signing.md#sg4-release-promotion-and-formula): the formula
# template, the absence of publishing commands (HD10) and the refusals of
# asura-release. Uses $scratch from static_checks.
sg4_static_checks() {
    template=$release/asura.rb.in
    for line in 'class Asura < Formula' '  homepage "https://github.com/pidster/asura"' \
        '  url "https://github.com/pidster/asura/releases/download/v@VERSION@/asura-@VERSION@-macos-arm64.tar.gz"' \
        '  sha256 "@SHA256@"' '  license "MIT"' '  depends_on arch: :arm64' '  depends_on macos: :golden_gate' \
        '    libexec.install "Asura.app"' '    bin.install_symlink libexec/"Asura.app/Contents/MacOS/asura"' \
        '    assert_equal "@VERSION@", shell_output("#{bin}/asura --version").strip' \
        '    system "/usr/bin/codesign", "--verify", "--deep", "--strict", app'; do
        check "formula template line: ${line#"${line%%[! ]*}"}" grep -Fqx -- "$line" "$template"
    done
    for digest in helper_sha256 metallib_sha256 hub_bundle_sha256; do
        check "formula test checks $digest" grep -Fq "manifest[\"$digest\"]" "$template"
    done
    check 'formula has no post_install, service, caveats or uninstall hook' sh -c '! grep -Eq "def (post_install|caveats)|^ *service do|uninstall" "$1"' sh "$template"
    check 'formula never runs the helper' sh -c '! grep -Eq "shell_output\\(.*asura-model|system .*asura-model" "$1"' sh "$template"
    check 'formula placeholders are only @VERSION@ and @SHA256@' \
        [ "$(grep -o '@[A-Z0-9_]*@' "$template" | LC_ALL=C sort -u | tr '\n' ' ')" = '@SHA256@ @VERSION@ ' ]
    for script in asura-release asura-bundle; do
        check "HD10: $script holds no publishing command" sh -c \
            '! grep -En "gh +release +(create|upload|edit|delete)|gi[t]( -C [^ ]+)? +(push|tag)|gh +api .*(-X|--method)|gh +repo +(create|edit)" "$1"' sh "$release/$script"
    done
    tool=$release/asura-release
    fake=$scratch/sg4
    mkdir -p "$fake"
    printf 'archive' > "$fake/asura-9.9.9-macos-arm64.tar.gz"
    (cd "$fake" && shasum -a 256 asura-9.9.9-macos-arm64.tar.gz > asura-9.9.9-macos-arm64.tar.gz.sha256)
    refuses_tool() { # LABEL EXPECTED ARGS... (no output file may appear)
        label=$1 expected=$2; shift 2
        set +e
        message=$("$tool" "$@" 2>&1 >/dev/null)
        status=$?
        set -e
        if [ "$status" -eq 1 ] && printf '%s' "$message" | grep -Fq -- "$expected" && [ ! -e "$fake/out.rb" ]; then
            pass "asura-release refuses: $label"
        else
            bad "asura-release refuses: $label (status $status: $message)"
        fi
    }
    a9=$fake/asura-9.9.9-macos-arm64.tar.gz
    refuses_tool 'unknown argument' 'unknown argument' check --bogus
    refuses_tool 'malformed version' 'MAJOR.MINOR.PATCH' preflight --version 1.0
    refuses_tool 'check without a kind' 'choose --release or --ad-hoc' check --version 9.9.9 --archive "$a9"
    refuses_tool 'release check without a team' 'team-id' check --release --version 9.9.9 --archive "$a9"
    refuses_tool 'ad hoc check with a team' 'takes no team ID' check --ad-hoc --team-id ABCDE12345 --version 9.9.9 --archive "$a9"
    refuses_tool 'missing archive' 'regular file' formula --version 9.9.9 --archive "$fake/none.tar.gz" --out "$fake/out.rb"
    refuses_tool 'formula for another version' 'does not match version' formula --version 9.9.8 --archive "$a9" --out "$fake/out.rb"
    : > "$fake/exists.rb"
    refuses_tool 'formula over an existing file' 'must not exist' formula --version 9.9.9 --archive "$a9" --out "$fake/exists.rb"
    cp "$a9.sha256" "$fake/keep"
    printf '%064d  asura-9.9.9-macos-arm64.tar.gz\n' 0 > "$a9.sha256"
    refuses_tool 'formula from an archive that fails its .sha256 (HD5)' 'does not match its .sha256' formula --version 9.9.9 --archive "$a9" --out "$fake/out.rb"
    mv "$fake/keep" "$a9.sha256"
    refuses_tool 'tap test of a formula for another version' 'is not the v9.9.8 release asset' tap-test --version 9.9.8 --formula "$template"
    refuses_tool 'verify-release without a revision' '--revision R is required' verify-release --version 9.9.9 --team-id ABCDE12345 --archive "$a9"
    if "$tool" formula --version 9.9.9 --archive "$a9" --out "$fake/asura.rb" >/dev/null; then
        digest=$(cut -d ' ' -f 1 < "$a9.sha256")
        check 'formula equals the template with the version and digest' \
            [ "$(cat "$fake/asura.rb")" = "$(sed -e 's/@VERSION@/9.9.9/g' -e "s/@SHA256@/$digest/g" "$template")" ]
    else
        bad 'formula writes the formula for a matching archive'
    fi
}

bundle_checks() {
    app=$1
    contents=$app/Contents
    check 'deep strict verification' codesign --verify --deep --strict "$app"
    for path in Info.plist MacOS/asura MacOS/asura-model Resources/mlx.metallib Resources/model-package.json \
        Resources/swift-transformers_Hub.bundle/Contents/Info.plist _CodeSignature/CodeResources; do
        check "layout: Contents/$path" [ -e "$contents/$path" ]
    done
    check 'no profile in an ad hoc bundle' [ ! -e "$contents/embedded.provisionprofile" ]
    check 'no other top-level entry' [ "$(ls "$contents" | LC_ALL=C sort | tr '\n' ' ')" = 'Info.plist MacOS Resources _CodeSignature ' ]
    check 'at most 64 files' [ "$(find "$app" -type f | wc -l | tr -d ' ')" -le 64 ]
    check 'bundle identifier' [ "$(value CFBundleIdentifier "$contents/Info.plist")" = org.pidster.asura ]
    check 'bundle executable' [ "$(value CFBundleExecutable "$contents/Info.plist")" = asura ]
    check 'bundle version' [ "$(value CFBundleVersion "$contents/Info.plist")" = "$(sed -n 's/^version = "\(.*\)"$/\1/p' "$root/rust/crates/asura-cli/Cargo.toml" | head -n 1)" ]
    info=$(codesign -d --verbose=2 "$contents/MacOS/asura-model" 2>&1)
    check 'helper identifier' sh -c 'printf "%s\n" "$1" | grep -qx "Identifier=org.pidster.asura.model"' sh "$info"
    check 'helper embedded Info.plist bound' sh -c 'printf "%s\n" "$1" | grep -Eq "^Info.plist entries=[1-9]"' sh "$info"
    check 'helper embedded CFBundleIdentifier' sh -c \
        'launchctl plist __TEXT,__info_plist "$1" | grep -Fq "\"CFBundleIdentifier\" = \"org.pidster.asura.model\""' \
        sh "$contents/MacOS/asura-model"
    for binary in asura asura-model; do
        info=$(codesign -d --verbose=2 "$contents/MacOS/$binary" 2>&1)
        check "$binary Hardened Runtime" sh -c 'printf "%s\n" "$1" | grep -Eq "^CodeDirectory .*flags=0x[0-9a-f]+\([^)]*runtime"' sh "$info"
        check "$binary ad hoc signature, no team" sh -c 'printf "%s\n" "$1" | grep -qx "Signature=adhoc" && printf "%s\n" "$1" | grep -qx "TeamIdentifier=not set"' sh "$info"
        # SG-V1 integration: the signed entitlements equal the tracked list.
        actual=$(codesign -d --entitlements - --xml "$contents/MacOS/$binary" 2>/dev/null || :)
        [ -n "$actual" ] || actual='<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict/></plist>'
        check "$binary entitlements equal $binary.ad-hoc.plist" sh -c \
            '[ "$(printf "%s" "$1" | plutil -p -)" = "$(plutil -p "$2")" ]' sh "$actual" "$release/entitlements/$binary.ad-hoc.plist"
        check "$binary has no get-task-allow" sh -c '! printf "%s" "$1" | grep -q get-task-allow' sh "$actual"
    done
    check 'app identifier' sh -c 'codesign -d --verbose=2 "$1" 2>&1 | grep -qx "Identifier=org.pidster.asura"' sh "$app"
    check 'Hub bundle signed ad hoc' sh -c 'codesign -d --verbose=2 "$1" 2>&1 | grep -qx "Signature=adhoc"' sh "$contents/Resources/swift-transformers_Hub.bundle"
    # SG-V2 integration: digests inside the bundle equal the package identity.
    manifest=$contents/Resources/model-package.json
    field() { plutil -extract "$1" raw -o - "$manifest"; }
    hub=$(cd "$contents/Resources/swift-transformers_Hub.bundle" && find . -type f | sed 's|^\./||' | LC_ALL=C sort |
        tr '\n' '\0' | xargs -0 shasum -a 256 | shasum -a 256 | cut -d ' ' -f 1)
    check 'manifest format 0.1' [ "$(field format)" = 0.1 ]
    check 'helper digest equals model-package.json' [ "$(shasum -a 256 "$contents/MacOS/asura-model" | cut -d ' ' -f 1)" = "$(field helper_sha256)" ]
    check 'metallib digest equals model-package.json' [ "$(shasum -a 256 "$contents/Resources/mlx.metallib" | cut -d ' ' -f 1)" = "$(field metallib_sha256)" ]
    check 'Hub bundle digest equals model-package.json' [ "$hub" = "$(field hub_bundle_sha256)" ]
    check 'schema digest equals model.proto' [ "$(shasum -a 256 "$root/contracts/model/v1/model.proto" | cut -d ' ' -f 1)" = "$(field schema_sha256)" ]
    identity=$root/.build/model-tools/package-identity.txt
    check 'package-identity.txt equals model-package.json' [ "$(cat "$identity")" = \
        "$(printf '%s\n' "$(field build_id)" "$(field schema_sha256)" "$(field helper_sha256)" "$(field metallib_sha256)" "$(field hub_bundle_sha256)")" ]
    check 'asura binary embeds the helper and Hub bundle digests' /usr/bin/python3 -I -c \
        'import sys; data = open(sys.argv[1], "rb").read(); sys.exit(0 if all(bytes.fromhex(h) in data for h in sys.argv[2:]) else 1)' \
        "$contents/MacOS/asura" "$(field helper_sha256)" "$(field hub_bundle_sha256)" "$(field build_id)"
    # SG4-O1 (release-signing.md#build-host-paths-sg4-o1): a raw-byte scan,
    # independent of host-paths, of every file; then the mechanism evidence.
    check 'SG4-O1: no file holds the home, /Users/, the repository or /<user>/' /usr/bin/python3 -I -c '
import os, sys
needles = [n.encode() for n in sys.argv[2:]]
found = []
for base, dirs, names in os.walk(sys.argv[1]):
    for name in names:
        path = os.path.join(base, name)
        data = os.readlink(path).encode() if os.path.islink(path) else open(path, "rb").read()
        hits = ["%s x%d" % (n.decode(), data.count(n)) for n in needles if n in data]
        if hits:
            found.append(os.path.relpath(path, sys.argv[1]) + ": " + ", ".join(hits))
for line in found:
    print("  " + line)
sys.exit(1 if found else 0)' "$app" "$HOME" /Users/ "$root" "/$(id -un)/"
    commit=$(cd "$root" && rustc -vV | sed -n 's/^commit-hash: //p')
    check 'SG4-O1: asura panic locations name /cargo/registry/src/' sh -c 'LC_ALL=C grep -aq "/cargo/registry/src/index.crates.io-" "$1"' sh "$contents/MacOS/asura"
    check 'SG4-O1: asura standard library locations name /rustc/<commit>/library/' sh -c 'LC_ALL=C grep -aq "/rustc/$2/library/" "$1"' sh "$contents/MacOS/asura" "$commit"
    check 'SG4-O1: helper C and C++ locations name /asura/ or /swiftpm/ checkouts' sh -c \
        'LC_ALL=C grep -aqE "/(asura/\.build/[^/]+|swiftpm)/checkouts/" "$1"' sh "$contents/MacOS/asura-model"
    check 'SG4-O1: helper carries no debug map (no N_SO or N_OSO stab)' sh -c \
        '! nm -ap "$1" | grep -Eq "^[0-9a-f]+ - [0-9a-f]+ [0-9a-f]+ +(SO|OSO|SOL) "' sh "$contents/MacOS/asura-model"
    # SG4: the dry-run archive beside the bundle passes the ad hoc archive check
    # (manifest, signatures, digests, asura --version) and yields a formula.
    version=$(value CFBundleShortVersionString "$contents/Info.plist")
    archive=$(dirname -- "$app")/asura-$version-macos-arm64-adhoc-unstapled.tar.gz
    if [ -f "$archive" ]; then
        log=$(mktemp -d "${TMPDIR:-/tmp}/asura-bundle-test.XXXXXXXX")
        if "$release/asura-release" check --ad-hoc --version "$version" --archive "$archive" > "$log/check.txt" 2>&1; then
            pass "asura-release check --ad-hoc ($(tail -n 1 "$log/check.txt"))"
        else
            bad "asura-release check --ad-hoc"; grep '^FAIL' "$log/check.txt" | sed 's/^/  /'
        fi
        check 'asura-release formula from the dry-run archive' \
            "$release/asura-release" formula --version "$version" --archive "$archive" --out "$log/asura.rb"
        check 'check records the pinned rustc of rust-toolchain.toml' grep -Fq \
            "RECORD rustc rustc $(sed -n 's/^channel = "\(.*\)"$/\1/p' "$root/rust-toolchain.toml") " "$log/check.txt"
        check 'SG4-O1: check passes the build-host path rule' \
            grep -Fqx 'PASS no file holds the account home, the repository path or the user name (SG4-O1)' "$log/check.txt"
        # SG4-O1: the same archive with the home planted in LICENSE (outside
        # the signed bundle) fails exactly one check, the build-host path rule.
        mkdir "$log/tree" "$log/planted"
        tar -xzf "$archive" -C "$log/tree"
        printf 'built in %s\n' "$HOME" >> "$log/tree/LICENSE"
        COPYFILE_DISABLE=1 tar --no-mac-metadata -czf "$log/planted/$(basename "$archive")" -C "$log/tree" Asura.app LICENSE
        (cd "$log/planted" && shasum -a 256 "$(basename "$archive")" > "$(basename "$archive").sha256")
        "$release/asura-release" check --ad-hoc --version "$version" --archive "$log/planted/$(basename "$archive")" \
            > "$log/planted.txt" 2>&1 || :
        check 'SG4-O1: a planted home path fails only the build-host path rule' \
            [ "$(grep '^FAIL' "$log/planted.txt")" = 'FAIL no file holds the account home, the repository path or the user name (SG4-O1)' ]
        check 'SG4-O1: the report names LICENSE' grep -Fqx '  LICENSE: home 1, repository 0, user 1' "$log/planted.txt"
        rm -rf "$log"
    else
        bad "no dry-run archive beside the bundle: $archive"
    fi
}

# SG-V5 (release-signing.md#sg2-delivery). The shipped helper list reads only
# the account home's ~/.asura, and tests never use it, so the checks re-sign a
# copy of the bundle's helper as a test-only variant: the shipped list plus a
# read-only absolute-path exception for the harness homes under /private/tmp/,
# under the probe identifier, never the product identifier. No release list
# carries that exception (--static).
probe_id=org.pidster.asura.probe.model
harness_root=/private/tmp/
sandbox_checks() {
    app=$1
    contents=$app/Contents
    [ -n "${ASURA_PROTOC:-}" ] || { bad 'the journey build needs ASURA_PROTOC'; return; }
    account_home=$(/usr/bin/python3 -I -c 'import os, pwd; print(pwd.getpwuid(os.getuid()).pw_dir)')
    container=$account_home/Library/Containers/$probe_id
    work=$(mktemp -d /private/tmp/asura-sg-v5.XXXXXXXX)
    identity=$root/.build/model-tools/package-identity.txt
    [ -f "$identity" ] && cp -p "$identity" "$work/package-identity.txt.saved"
    finish() {
        # Restore the bundle's package identity; remove the work tree and the
        # removable contents of the probe container, then list what remains.
        if [ -f "$work/package-identity.txt.saved" ]; then
            cp -p "$work/package-identity.txt.saved" "$identity"
        fi
        rm -rf "$work"
        if [ -d "$container" ]; then
            rm -rf "$container/Data" 2>/dev/null || :
            printf 'NOTE probe container %s keeps: %s\n' "$container" "$(ls -A "$container" | tr '\n' ' ')"
        fi
    }
    trap 'finish' EXIT
    trap 'finish; exit 130' INT TERM

    # The shipped list, from the bundle's helper, plus the test exception.
    shipped=$work/shipped.plist
    codesign -d --entitlements - --xml "$contents/MacOS/asura-model" > "$shipped" 2>/dev/null || :
    check 'bundle helper claims the shipped ad hoc list' \
        [ "$(plutil -p "$shipped" 2>/dev/null)" = "$(plutil -p "$release/entitlements/asura-model.ad-hoc.plist")" ]
    check 'bundle helper claims the App Sandbox' [ "$(value com.apple.security.app-sandbox "$shipped")" = true ]
    test_list=$work/asura-model.sg-v5.plist
    key=com.apple.security.temporary-exception.files.absolute-path.read-only
    plutil -convert xml1 -o "$test_list" "$shipped" &&
        /usr/libexec/PlistBuddy -c "Add :$key array" -c "Add :$key:0 string $harness_root" "$test_list" >/dev/null ||
        { bad 'cannot write the test entitlement list'; return; }
    check 'test list is the shipped list plus only the harness exception' sh -c \
        '[ "$(plutil -convert json -o - "$1" | /usr/bin/python3 -I -c "import json,sys; d=json.load(sys.stdin); d.pop(sys.argv[1]); print(json.dumps(d, sort_keys=True))" "$3")" = "$(plutil -convert json -o - "$2" | /usr/bin/python3 -I -c "import json,sys; print(json.dumps(json.load(sys.stdin), sort_keys=True))")" ]' \
        sh "$test_list" "$shipped" "$key"

    # The variant: the bundle copied, its helper's embedded Info.plist set to
    # the probe identifier (same section size), re-signed ad hoc and hardened.
    variant=$work/Asura.app
    ditto --norsrc --noextattr --noqtn "$app" "$variant" || { bad 'cannot copy the bundle'; return; }
    helper=$variant/Contents/MacOS/asura-model
    check 'variant Info.plist names the probe identifier' /usr/bin/python3 -I - "$helper" "$probe_id" <<'PY'
import plistlib, subprocess, sys
path, identifier = sys.argv[1], sys.argv[2]
data = bytearray(open(path, "rb").read())
if data[:4] != b"\xcf\xfa\xed\xfe":
    sys.exit("not a thin 64-bit Mach-O")
lines = subprocess.run(["/usr/bin/otool", "-l", path], capture_output=True, text=True, check=True).stdout.splitlines()
start = [n for n, line in enumerate(lines) if line.split() == ["sectname", "__info_plist"]]
if len(start) != 1:
    sys.exit("expected one __info_plist section")
fields = dict(line.split()[:2] for line in lines[start[0] + 1:start[0] + 8] if len(line.split()) == 2)
size, offset = int(fields["size"], 16), int(fields["offset"])
info = plistlib.loads(bytes(data[offset:offset + size]))
if info.get("CFBundleIdentifier") != "org.pidster.asura.model":
    sys.exit("the bundle helper does not embed org.pidster.asura.model")
info["CFBundleIdentifier"] = identifier
text = b"\n".join(line.lstrip(b"\t") for line in plistlib.dumps(info).split(b"\n"))
if len(text) > size:
    sys.exit("the probe Info.plist does not fit the section")
text = text.replace(b"</dict>", b" " * (size - len(text)) + b"</dict>", 1)
data[offset:offset + size] = text
if plistlib.loads(bytes(data[offset:offset + size])) != info:
    sys.exit("the patched Info.plist does not parse back")
open(path, "wb").write(data)
PY
    codesign --force --sign - --timestamp=none --identifier "$probe_id" --options runtime \
        --entitlements "$test_list" "$helper" 2>/dev/null &&
        codesign --force --sign - --timestamp=none --options runtime \
            --entitlements "$release/entitlements/asura.ad-hoc.plist" "$variant" 2>/dev/null ||
        { bad 'cannot sign the test variant'; return; }
    check 'variant deep strict verification' codesign --verify --deep --strict "$variant"
    info=$(codesign -d --verbose=2 "$helper" 2>&1)
    check 'variant helper identifier is the probe identifier' sh -c 'printf "%s\n" "$1" | grep -qx "Identifier=$2"' sh "$info" "$probe_id"
    check 'variant helper Info.plist bound' sh -c 'printf "%s\n" "$1" | grep -Eq "^Info.plist entries=[1-9]"' sh "$info"
    check 'variant helper Hardened Runtime, ad hoc' sh -c \
        'printf "%s\n" "$1" | grep -Eq "^CodeDirectory .*flags=0x[0-9a-f]+\([^)]*runtime" && printf "%s\n" "$1" | grep -qx "Signature=adhoc"' sh "$info"
    check 'variant helper embedded CFBundleIdentifier' sh -c \
        'launchctl plist __TEXT,__info_plist "$1" | grep -Fq "\"CFBundleIdentifier\" = \"$2\""' sh "$helper" "$probe_id"
    actual=$(codesign -d --entitlements - --xml "$helper" 2>/dev/null || :)
    check 'variant helper entitlements equal the test list' sh -c \
        '[ "$(printf "%s" "$1" | plutil -p -)" = "$(plutil -p "$2")" ]' sh "$actual" "$test_list"
    check 'variant helper reports the bundle build identity' sh -c \
        'cp "$1" "$3/version-copy" && codesign --force --sign - --timestamp=none "$3/version-copy" 2>/dev/null &&
         "$3/version-copy" --version | grep -Fq " build=$(plutil -extract build_id raw -o - "$2") "' \
        sh "$helper" "$contents/Resources/model-package.json" "$work"

    # HS-P7: the negative fixture shares the variant's identifier, container
    # and entitlement list. The control has no entitlements.
    probe_info=$work/probe-Info.plist
    cp "$root/swift/model-helper/Support/Info.plist" "$probe_info"
    /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $probe_id" -c 'Set :CFBundleExecutable sandbox-probe' \
        -c 'Set :CFBundleName sandbox-probe' "$probe_info"
    xcrun --sdk macosx clang -O2 -Wall -Wextra -Werror -o "$work/sandbox-probe" "$release/sandbox-probe.c" \
        "-Wl,-sectcreate,__TEXT,__info_plist,$probe_info" || { bad 'cannot build the negative fixture'; return; }
    cp "$work/sandbox-probe" "$work/sandbox-probe-control"
    codesign --force --sign - --timestamp=none --identifier "$probe_id" --options runtime \
        --entitlements "$test_list" "$work/sandbox-probe" 2>/dev/null &&
        codesign --force --sign - --timestamp=none --identifier org.pidster.asura.probe.control \
            "$work/sandbox-probe-control" 2>/dev/null ||
        { bad 'cannot sign the negative fixture'; return; }
    ssh=$account_home/.ssh
    ssh_file=$ssh/known_hosts
    for name in known_hosts config authorized_keys; do
        if [ -f "$ssh/$name" ] && [ ! -L "$ssh/$name" ]; then ssh_file=$ssh/$name; break; fi
    done
    outside=$account_home/.asura-sg-v5-$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')
    printf 'x\n' > "$work/read-probe"
    mkdir "$work/control-home"
    control=$(env HOME="$work/control-home" "$work/sandbox-probe-control" "$ssh" "$ssh_file" - \
        "$work/write-probe" "$work/read-probe")
    sandboxed=$("$work/sandbox-probe" "$ssh" "$ssh_file" "$outside" "$work/write-probe" "$work/read-probe")
    result() { printf '%s\n' "$1" | sed -n "s/^$2 //p"; }
    check 'control: fixture is not sandboxed' [ "$(result "$control" sandboxed)" = no ]
    check 'control: writes to /private/tmp' [ "$(result "$control" write-tmp)" = allowed ]
    check 'HS-P7: fixture with the helper list is sandboxed' [ "$(result "$sandboxed" sandboxed)" = yes ]
    if [ -d "$ssh" ]; then
        check 'control: lists ~/.ssh' [ "$(result "$control" ssh-list)" = allowed ]
        check 'HS-P7: ~/.ssh listing denied' [ "$(result "$sandboxed" ssh-list)" = denied ]
    else
        skip "~/.ssh does not exist; listing denial not shown"
    fi
    if [ -f "$ssh_file" ]; then
        check "control: opens ~/.ssh/$(basename "$ssh_file")" [ "$(result "$control" ssh-open)" = allowed ]
        check "HS-P7: ~/.ssh/$(basename "$ssh_file") read denied" [ "$(result "$sandboxed" ssh-open)" = denied ]
    else
        skip "no regular file in ~/.ssh; file read denial not shown"
    fi
    check 'HS-P7: write to the account home denied' [ "$(result "$sandboxed" write-outside)" = denied ]
    if [ -e "$outside" ]; then
        rm -f "$outside"
        bad 'HS-P7: a file was left in the account home (removed)'
    fi
    check 'HS-P7: write to the read-only harness exception denied' [ "$(result "$sandboxed" write-tmp)" = denied ]
    check 'HS-P7: read through the harness exception allowed' [ "$(result "$sandboxed" read-tmp)" = allowed ]
    check 'HS-P7: write inside the container allowed' [ "$(result "$sandboxed" write-container)" = allowed ]
    check 'HS-P1: the probe container exists' [ -d "$container/Data" ]

    # HS-P1 to HS-P6 end to end: the journey embeds the variant's identity.
    field() { plutil -extract "$1" raw -o - "$contents/Resources/model-package.json"; }
    printf '%s\n' "$(field build_id)" "$(field schema_sha256)" \
        "$(shasum -a 256 "$helper" | cut -d ' ' -f 1)" "$(field metallib_sha256)" "$(field hub_bundle_sha256)" \
        > "$work/package-identity.txt"
    mkdir -p "$(dirname -- "$identity")"
    cp "$work/package-identity.txt" "$identity"
    journey=$(cargo test --manifest-path "$root/Cargo.toml" -p asura-service --test conversation_flow --locked \
        --no-run --message-format=json 2>"$work/build.log" | /usr/bin/python3 -I -c '
import json, sys
for line in sys.stdin:
    message = json.loads(line)
    if message.get("reason") == "compiler-artifact" and message["target"]["name"] == "conversation_flow" and message.get("executable"):
        print(message["executable"])') || :
    if [ -z "$journey" ] || [ ! -x "$journey" ]; then
        bad "cannot build conversation_flow: $(tail -n 5 "$work/build.log")"
        return
    fi
    ollama=${ASURA_TEST_OLLAMA_MODEL:-granite4.1:8b}
    if tags=$(curl -sf http://127.0.0.1:11434/api/tags 2>/dev/null) &&
        printf '%s' "$tags" | /usr/bin/python3 -I -c 'import json, sys; sys.exit(0 if sys.argv[1] in [m.get("name") for m in json.load(sys.stdin).get("models", [])] else 1)' "$ollama"; then
        :
    else
        ollama=
    fi
    set +e
    ASURA_TEST_BUNDLE=$variant ASURA_TEST_OLLAMA_MODEL=$ollama "$journey" --bundle-sandbox > "$work/journey.log" 2>&1
    status=$?
    set -e
    sed 's/^/  journey: /' "$work/journey.log"
    check 'journey --bundle-sandbox exits 0' [ "$status" -eq 0 ]
    for line in 'PASS sandboxed inventory' 'PASS sandboxed helper completed a system provider turn' \
        'PASS sandboxed helper copies removed' 'PASS interrupted recovery' 'PASS bundle sandbox'; do
        check "journey: $line" grep -Fq "$line" "$work/journey.log"
    done
    if [ -n "${ASURA_TEST_MLX_ASSET:-}" ]; then
        check 'journey: HS-P3 sandboxed MLX turn' grep -Fq 'PASS sandboxed helper completed an MLX turn' "$work/journey.log"
    else
        skip 'HS-P3 MLX: ASURA_TEST_MLX_ASSET is not set'
    fi
    if [ -n "$ollama" ]; then
        check 'journey: HS-P5 sandboxed Ollama turn' grep -Fq 'PASS sandboxed helper completed an Ollama' "$work/journey.log"
    else
        skip "HS-P5 Ollama: no local Ollama serves ${ASURA_TEST_OLLAMA_MODEL:-granite4.1:8b}"
    fi
    check 'HS-P1: the probe container exists after the journey' [ -d "$container/Data" ]
}

case "${1:-}" in
    --static) [ "$#" -eq 1 ] || { echo "$0 --static" >&2; exit 2; }; static_checks ;;
    --bundle) [ "$#" -eq 2 ] && [ -d "$2" ] || { echo "$0 --bundle PATH/Asura.app" >&2; exit 2; }; bundle_checks "$2" ;;
    --sandbox) [ "$#" -eq 2 ] && [ -d "$2" ] || { echo "$0 --sandbox PATH/Asura.app" >&2; exit 2; }; sandbox_checks "$2" ;;
    *) sed -n '2,21p' "$0" >&2; exit 2 ;;
esac
printf '%s passed, %s failed, %s skipped\n' "$passed" "$failed" "$skipped"
[ "$failed" -eq 0 ]
